=== grimoire_appendicesCollection
@grimoireAppendix
+ {grimoire_appendices has grimChoicesMentor or grimoire_appendices has grimChoicesWitch or grimoire_appendices has tutorialChoicesRelationship}[Conversation]
    -> grimoire_choicesAndRelationships

+ {grimoire_appendices has grimGreenhouseMentor or grimoire_appendices has tutorialGreenhouse or greenhouse_findedCultivables != ()}[Present]
    -> grimoire_greenhouseAndGifts

+ {grimoire_appendices has grimFirstOpenKitchen}[Kitchen]
    -> grimoire_kitchenAndRelationships

+ {grimoire_appendices has grimInkMentor or grimoire_appendices has tutorialRereading}[Rewrite]
    -> grimoire_inkAndRewriting

+ {grimoire_appendices has grimSigilsMentor or grimoire_appendices has grimSigilsWitch}[Nest]
    -> grimoire_Sigils

+ {horizontalS_discoveredDocs!= ()}[Letters]
    -> grimoire_lettersAndDocuments

    
+ [Index #bookmark:index]
    -> grimoire
    -
    -> grimoire_appendicesCollection