                        ~   letters_thirdCharLetterTwoChoice += fireC
            
            - else:
                    Ma {player_pronoun has him:vecio|{player_pronoun has her:zia|bomber}}, devo ancora capire se fidarmi di te.
                    E quindi c'ho fatto di testa mia.
                        ~   letters_thirdCharLetterTwoChoice += fireC
            }
        - else:
